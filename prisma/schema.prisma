generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Better Auth (não mexer nos nomes dos campos, é o formato que a lib espera) ============

model User {
  id            String   @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // dados do app em si
  transactions          Transaction[]
  categories            Category[]
  monthlyPlans          MonthlyPlan[]
  fixedExpenseTemplates FixedExpenseTemplate[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ============ Modelos do app ============
// De propósito bem simples: sem conta bancária, sem transferência, sem saldo
// guardado em lugar nenhum. O "saldo" é sempre calculado na hora (receita -
// despesas - investimento planejado) pro mês que tá sendo visto, nunca salvo.

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExpenseSubtype {
  FIXED
  VARIABLE
}

model Category {
  id        String          @id @default(cuid())
  name      String
  kind      TransactionType @default(EXPENSE)
  color     String?
  createdAt DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("category")
}

model Transaction {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  // só faz sentido quando type = EXPENSE
  subtype     ExpenseSubtype?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Preenchido quando essa linha foi gerada automaticamente por uma despesa
  // fixa recorrente (olha o FixedExpenseTemplate). Editar/excluir essa linha
  // só mexe nesse mês específico — nunca no template nem nos outros meses,
  // assim o histórico não muda escondido se eu alterar o valor depois.
  templateId String?
  template   FixedExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Parcelamento: todas as parcelas de uma compra compartilham o mesmo
  // installmentGroupId. Fora isso cada linha é uma Transaction independente —
  // editar/excluir uma não mexe nas outras (por enquanto não tem uma ação de
  // "editar/excluir todas as parcelas de uma vez", só linha por linha mesmo).
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  @@index([userId])
  @@index([categoryId])
  @@index([date])
  @@index([templateId])
  @@index([installmentGroupId])
  @@map("transaction")
}

// Guarda um (template, mês, ano) que o usuário mandou excluir só naquele mês
// específico — sem isso, da próxima vez que esse mês fosse aberto o
// ensureFixedExpenseInstances ia recriar a mesma despesa de novo.
model FixedExpenseSkip {
  id         String @id @default(cuid())
  month      Int
  year       Int

  templateId String
  template   FixedExpenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, month, year])
  @@map("fixed_expense_skip")
}

// Uma despesa fixa recorrente (aluguel, assinatura, etc). Não guarda o valor
// de nenhum mês específico — é um modelo que vai sendo "materializado" numa
// Transaction de verdade, independente, na primeira vez que aquele mês é
// aberto (ver src/lib/fixed-expenses.ts). Assim, editar o modelo só afeta os
// meses que ainda não foram gerados, e o histórico dos meses passados nunca
// muda escondido.
model FixedExpenseTemplate {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(14, 2)
  // dia do vencimento (1-31, ajustado pra baixo em meses mais curtos)
  dayOfMonth  Int
  startMonth  Int
  startYear   Int
  // null = repete pra sempre, sem data de término
  endMonth    Int?
  endYear     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  skips        FixedExpenseSkip[]

  @@index([userId])
  @@map("fixed_expense_template")
}

// One row per user per calendar month: the "Investir" simulation — what % of
// that month's income the user plans to set aside, and whether they've
// confirmed they actually did it.
model MonthlyPlan {
  id               String   @id @default(cuid())
  month            Int
  year             Int
  investPercentage Decimal  @default(0) @db.Decimal(5, 2)
  confirmed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("monthly_plan")
}
